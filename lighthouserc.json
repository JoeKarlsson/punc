{
  "ci": {
    "collect": {
      "staticDistDir": "site-dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/books/frankenstein/index.html",
        "http://localhost/books/nineteen-eighty-four/index.html",
        "http://localhost/numbers.html",
        "http://localhost/read.html",
        "http://localhost/about.html",
        "http://localhost/books/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "//[^/]+/(index|read|books/[^/]+/index)\\.html$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2600,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 800000,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/numbers\\.html$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3000,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 1100000,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/about\\.html$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2900,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/books/index\\.html$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3100,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 300,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
